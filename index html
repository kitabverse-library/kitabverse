<script src="./js/script.js"></script>
<script>
const menuBtn=document.getElementById('menuBtn'),sideMenu=document.getElementById('sideMenu'),closeMenu=document.getElementById('closeMenu');
menuBtn.onclick=()=>sideMenu.classList.add('show'); closeMenu.onclick=()=>sideMenu.classList.remove('show');
function openModal(id){sideMenu.classList.remove('show');document.getElementById(id).classList.add('show'); if(id==='calendarModal') renderCalendar(); if(id==='visitorModal') updateVisitorModal();}
function closeModal(id){document.getElementById(id).classList.remove('show');}
function showVision(){openModal('visionModal');}
window.openModal=openModal; window.closeModal=closeModal; window.showVision=showVision;
const brailleMap={a:'⠁',b:'⠃',c:'⠉',d:'⠙',e:'⠑',f:'⠋',g:'⠛',h:'⠓',i:'⠊',j:'⠚',k:'⠅',l:'⠇',m:'⠍',n:'⠝',o:'⠕',p:'⠏',q:'⠟',r:'⠗',s:'⠎',t:'⠞',u:'⠥',v:'⠧',w:'⠺',x:'⠭',y:'⠽',z:'⠵',' ':'⠀'};
function toBraille(t){return t.toLowerCase().split('').map(c=>brailleMap[c]||c).join('');}
function convertToBraille(text){if(!text) return; const b=toBraille(text); document.getElementById('brailleOutput').innerText=b; document.getElementById('dictBraille').innerText=b;}
function speakText(text,lang){if(!text) return; if('speechSynthesis' in window){speechSynthesis.cancel(); const u=new SpeechSynthesisUtterance(text); u.lang=lang||document.getElementById('voiceLang')?.value||'en-IN'; u.rate=0.9; speechSynthesis.speak(u);}}
function speakModal(){const body=document.getElementById('modalBody').innerText; speakText(body);}
function showBrailleFromModal(){const body=document.getElementById('modalBody').innerText.slice(0,200); openModal('brailleModal'); document.getElementById('brailleInput').value=body; convertToBraille(body);}
function handleDict(){const w=document.getElementById('dictInput').value; if(!w) return; convertToBraille(w); speakText(w);}
window.convertToBraille=convertToBraille; window.speakText=speakText; window.speakModal=speakModal; window.showBrailleFromModal=showBrailleFromModal; window.handleDict=handleDict;
function startVoice(){
 const lang=document.getElementById('voiceLang').value; const langText=document.getElementById('voiceLang').options[document.getElementById('voiceLang').selectedIndex].text;
 const status=document.getElementById('voiceStatus'), result=document.getElementById('voiceResult'), anim=document.getElementById('voiceAnim'), btn=document.getElementById('voiceStartBtn');
 if(!('webkitSpeechRecognition' in window||'SpeechRecognition' in window)){status.textContent='Use Chrome on Android';return;}
 const Rec=window.SpeechRecognition||window.webkitSpeechRecognition; const rec=new Rec(); rec.lang=lang; rec.interimResults=false;
 btn.textContent='🔴 Listening...'; anim.style.display='block'; status.textContent='Listening in '+langText+'...';
 try{rec.start();}catch{}
 rec.onresult=e=>{const t=e.results[0][0].transcript; result.textContent='You said: '+t; document.getElementById('searchInput').value=t; applyFilters(); convertToBraille(t); speakText('Searching for '+t,lang); setTimeout(()=>closeModal('voiceModal'),1200);};
 rec.onerror=e=>{status.textContent='Error: '+e.error;}; rec.onend=()=>{btn.textContent='🎙 Start Speaking'; anim.style.display='none';};
}
window.startVoice=startVoice;
function alexaSearch(){
 const q=document.getElementById('alexaInput').value.trim(); if(!q) return;
 const resEl=document.getElementById('alexaResponse');
 resEl.textContent='Alexa: Searching for '+q+' in KitabVerse secure library...'; speakText('Searching for '+q, 'en-US');
 document.getElementById('searchInput').value=q; applyFilters();
}
window.alexaSearch=alexaSearch;
function renderCalendar(){
 const now=new Date(); const year=now.getFullYear(), month=now.getMonth();
 const first=new Date(year,month,1).getDay(); const days=new Date(year,month+1,0).getDate();
 let html=`<div style="text-align:center;font-weight:700;color:#d4af37">${now.toLocaleString('default',{month:'long'})} ${year}</div><div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-top:8px;text-align:center;font-size:11px">`;
 ['Su','Mo','Tu','We','Th','Fr','Sa'].forEach(d=>html+=`<div style="opacity:.5">${d}</div>`);
 for(let i=0;i<first;i++) html+=`<div></div>`;
 for(let d=1;d<=days;d++){ const isToday=d===now.getDate(); html+=`<div style="padding:6px;border-radius:6px;${isToday?'background:#d4af37;color:#000;font-weight:700':''}">${d}</div>`; }
 html+=`</div>`; document.getElementById('calendarDiv').innerHTML=html;
}
(function(){
 let visits=parseInt(localStorage.getItem('kv_visits')||'0')+1; localStorage.setItem('kv_visits',visits);
 let total=parseInt(localStorage.getItem('kv_total')||'1240')+1; localStorage.setItem('kv_total',total);
 document.getElementById('visitCount').textContent=total; document.getElementById('visitorBig').textContent=total; document.getElementById('footerVisits').textContent=total;
 document.getElementById('todayVisits').textContent='1'; document.getElementById('monthVisits').textContent=Math.floor(total/3);
 const today=new Date().toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'short',year:'numeric'});
 document.getElementById('todayDate').textContent=today; document.getElementById('footerDate').textContent=today;
})();
function updateVisitorModal(){ const total=localStorage.getItem('kv_total')||'1240'; document.getElementById('visitorBig').textContent=total; }
window.addEventListener('click',e=>{if(e.target.classList.contains('modal')) e.target.classList.remove('show');});
</script>
</body>
